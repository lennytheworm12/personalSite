---
import BaseLayout from "@/layouts/BaseLayout.astro";
import UnresolvedList from "@/components/UnresolvedList.astro";
import { buildMetadata } from "@/lib/metadata";
import { withBase } from "@/lib/base-path";
import { projects } from "@/content/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: (typeof projects)[number];
}

const { project } = Astro.props as Props;

const metadata = buildMetadata({
  title: project.title,
  description: project.tagline,
  path: `/projects/${project.slug}/`,
});

const narrativeSections = [
  { key: "motivation", heading: "Motivation" },
  { key: "contribution", heading: "Contribution" },
  { key: "evidence", heading: "Evidence" },
  { key: "challenges", heading: "Challenges" },
  { key: "outcomes", heading: "Outcomes" },
  { key: "nextSteps", heading: "Next steps" },
] as const;
---

<BaseLayout metadata={metadata} currentPath={`/projects/${project.slug}/`}>
  <article>
    <header>
      <h1>{project.title}</h1>
      <p>{project.tagline}</p>
      {
        project.status === "placeholder" && (
          <p>
            <span class="badge">Placeholder case study</span>
          </p>
        )
      }
    </header>

    <section aria-labelledby="summary-heading">
      <h2 id="summary-heading">Summary</h2>
      <p>{project.summary}</p>
    </section>

    {
      narrativeSections.map(({ key, heading }) => {
        const section = project[key];
        return section ? (
          <section aria-labelledby={`${key}-heading`}>
            <h2 id={`${key}-heading`}>{heading}</h2>
            <p>
              {section.text}
              {section.provisional && (
                <span class="badge badge-provisional">Provisional draft</span>
              )}
            </p>
          </section>
        ) : null;
      })
    }

    {
      project.technologies.length > 0 && (
        <section aria-labelledby="technologies-heading">
          <h2 id="technologies-heading">Technologies</h2>
          <dl>
            {project.technologies.map((technology) => (
              <>
                <dt>
                  {technology.label}
                  <span class="badge">{technology.category}</span>
                  {technology.verification !== "verified" && (
                    <span class="badge badge-provisional">
                      {technology.verification}
                    </span>
                  )}
                </dt>
                <dd>
                  {technology.purpose.text}
                  {technology.purpose.provisional && " (provisional)"}
                </dd>
              </>
            ))}
          </dl>
        </section>
      )
    }

    {
      project.concepts.length > 0 && (
        <section aria-labelledby="concepts-heading">
          <h2 id="concepts-heading">Concepts</h2>
          <ul>
            {project.concepts.map((concept) => (
              <li>{concept}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      project.metrics.length > 0 && (
        <section aria-labelledby="metrics-heading">
          <h2 id="metrics-heading">Metrics</h2>
          <p class="placeholder-note">
            No quantitative evidence is claimed for this project yet.
          </p>
        </section>
      )
    }

    <UnresolvedList unresolved={project.unresolved} />

    {
      project.links.length > 0 && (
        <section aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <ul>
            {project.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel={link.role === "other" ? undefined : "noopener noreferrer"}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <p><a href={withBase("/")}>← Back to home</a></p>
</BaseLayout>
