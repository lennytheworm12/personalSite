---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildMetadata } from "@/lib/metadata";
import { withBase } from "@/lib/base-path";
import { projects } from "@/content/projects";
import { homeGraph, homeGraphResult } from "@/graph/graph-data";
import { HOME_LAYOUTS } from "@/graph/layouts";
import { FOCUS_LAYOUTS } from "@/graph/focus-layouts";
import HomepageIsland from "@/components/homepage/HomepageIsland";

const metadata = buildMetadata({
  title: "Home",
  description:
    "Portfolio of Bi Phan: software projects including Spotify Sorter and Game Teacher.",
  path: "/",
});

// Compact summaries only — never full case-study bodies.
const projectSummaries = projects.map((project) => ({
  slug: project.slug,
  title: project.title,
  tagline: project.tagline,
  status: project.status,
  contribution: project.contribution?.text,
  stack: project.technologies.map((technology) => technology.label),
}));

/**
 * Stable contact placeholders. Personal handles and URLs are unresolved
 * facts (see docs/decisions-log.md B4): rendered as plain text until
 * confirmed values exist — never invented. LeetCode is deferred (R2).
 */
const contacts = [
  {
    id: "contact-about",
    label: "About",
    note: "See the About page.",
    href: withBase("/about/"),
  },
  { id: "contact-github", label: "GitHub", note: "Profile URL not yet published." },
  { id: "contact-linkedin", label: "LinkedIn", note: "Profile URL not yet published." },
  { id: "contact-resume", label: "Résumé", note: "Résumé file not yet published." },
  { id: "contact-email", label: "Contact", note: "Email address not yet published." },
];
---

<BaseLayout metadata={metadata} currentPath="/">
  <h1>Bi Phan</h1>
  <p>
    Software engineer. This site is an honest, work-in-progress portfolio: every case
    study is real, and anything not yet written is marked as a placeholder rather than
    invented.
  </p>

  <HomepageIsland
    client:load
    graph={homeGraph}
    layouts={HOME_LAYOUTS}
    focusLayouts={FOCUS_LAYOUTS}
    projects={projectSummaries}
    contacts={contacts}
    caseStudyHrefBySlug={homeGraphResult.caseStudyHrefBySlug}
  />
</BaseLayout>
