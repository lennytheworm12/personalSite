{
  "name": "personal-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "astro check && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:content": "tsx scripts/verify-content.ts",
    "test:e2e": "astro preview stop > /dev/null 2>&1 || true; (astro preview --host 127.0.0.1 --port 4321 --strictPort > /tmp/portfolio-preview.log 2>&1 &); until curl -sf http://127.0.0.1:4321/ > /dev/null; do sleep 0.5; done; playwright test",
    "verify:build": "tsx scripts/verify-build.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm verify:content && pnpm test && pnpm build && pnpm verify:build && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
